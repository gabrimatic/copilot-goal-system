      {
        "command": "copilotGoalSystem.openInstalledFiles",
        "title": "Open Installed Files",
        "category": "Copilot Goal System",
        "icon": "$(folder-opened)"
      },
      {
        "command": "copilotGoalSystem.openStateFolder",
        "title": "Open Goal State Folder",
        "category": "Copilot Goal System",
        "icon": "$(database)"
