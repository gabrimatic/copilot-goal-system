{
  "name": "copilot-goal-system",
  "displayName": "Copilot Goal System",
  "description": "Install persisted goal mode for GitHub Copilot CLI and VS Code Copilot Chat.",
  "version": "1.1.11",
  "publisher": "gabrimatic",
  "author": {
    "name": "Soroush Yousefpour",
    "url": "https://github.com/gabrimatic"
  },
  "license": "SEE LICENSE IN LICENSE",
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f2a2a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrimatic/copilot-goal-system.git"
  },
  "bugs": {
    "url": "https://github.com/gabrimatic/copilot-goal-system/issues"
  },
  "homepage": "https://github.com/gabrimatic/copilot-goal-system#readme",
  "files": [
    "extension.cjs",
    "lib/**",
    "README.md",
    "CHANGELOG.md",
    "SUPPORT.md",
    "LICENSE",
    "package.json",
    "node_modules/jsonc-parser/**",
    "media/**",
    "resources/**"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "copilot",
    "github-copilot",
    "goal",
    "workflow",
    "persistence",
    "hooks",
    "skills",
    "verification"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:copilotGoalSystem.install",
    "onCommand:copilotGoalSystem.installCli",
    "onCommand:copilotGoalSystem.installVscodeChat",
    "onCommand:copilotGoalSystem.status",
    "onCommand:copilotGoalSystem.openWalkthrough",
    "onCommand:copilotGoalSystem.copyPrompt",
    "onCommand:copilotGoalSystem.openDocs",
    "onCommand:copilotGoalSystem.openInstalledFiles",
    "onCommand:copilotGoalSystem.openStateFolder"
  ],
  "main": "./extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "copilotGoalSystem.install",
        "title": "Install Recommended Setup",
        "category": "Copilot Goal System",
        "icon": "$(cloud-download)"
      },
      {
        "command": "copilotGoalSystem.installCli",
        "title": "Install into Copilot CLI",
        "category": "Copilot Goal System",
        "icon": "$(terminal)"
      },
      {
        "command": "copilotGoalSystem.installVscodeChat",
        "title": "Install into VS Code Copilot Chat",
        "category": "Copilot Goal System",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "copilotGoalSystem.status",
        "title": "Show Status",
        "category": "Copilot Goal System",
        "icon": "$(pulse)"
      },
      {
        "command": "copilotGoalSystem.openWalkthrough",
        "title": "Open Setup Walkthrough",
        "category": "Copilot Goal System",
        "icon": "$(checklist)"
      },
      {
        "command": "copilotGoalSystem.copyPrompt",
        "title": "Copy Test Prompt",
        "category": "Copilot Goal System",
        "icon": "$(copy)"
      },
      {
        "command": "copilotGoalSystem.openDocs",
        "title": "Open Documentation",
        "category": "Copilot Goal System",
        "icon": "$(book)"
      },
      {
        "command": "copilotGoalSystem.openInstalledFiles",
        "title": "Open Installed Files",
        "category": "Copilot Goal System",
        "icon": "$(folder-opened)"
      },
      {
        "command": "copilotGoalSystem.openStateFolder",
        "title": "Open Goal State Folder",
        "category": "Copilot Goal System",
        "icon": "$(database)"
      }
    ],
    "configuration": {
      "title": "Copilot Goal System",
      "properties": {
        "copilotGoalSystem.homeOverride": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Set a home directory for install and status commands. Leave empty to use the current OS account home."
        },
        "copilotGoalSystem.showStatusAfterInstall": {
          "type": "boolean",
          "default": true,
          "description": "Show the install status report after install or update."
        },
        "copilotGoalSystem.promptOnFirstRun": {
          "type": "boolean",
          "default": true,
          "description": "Show one setup prompt when the local Copilot profile is missing the goal system."
        },
        "copilotGoalSystem.promptOnUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Prompt after extension updates when local Copilot runtime files are older than the bundled files."
        },
        "copilotGoalSystem.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the compact Copilot Goal System item in the VS Code status bar."
        },
        "copilotGoalSystem.vscodeMcpConfigPathOverride": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Set a custom VS Code MCP config path. Leave empty to use the detected VS Code profile path."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "copilotGoalSystem.setup",
        "title": "Set Up Copilot Goal System",
        "description": "Persist one active goal for GitHub Copilot CLI and VS Code Copilot Chat.",
        "steps": [
          {
            "id": "install",
            "title": "Install or update the local goal system",
            "description": "Copy the bundled goal system, install production dependencies, merge CLI hooks, add the VS Code Chat custom agent, and configure the local MCP server.",
            "media": {
              "image": "media/walkthrough-install.svg",
              "altText": "Goal system install flow"
            },
            "completionEvents": [
              "onCommand:copilotGoalSystem.install"
            ]
          },
          {
            "id": "status",
            "title": "Check installation status",
            "description": "Confirm extension files, dependencies, CLI hooks, VS Code Chat hooks, custom agent, and MCP configuration.",
            "media": {
              "image": "media/walkthrough-status.svg",
              "altText": "Goal system status checks"
            },
            "completionEvents": [
              "onCommand:copilotGoalSystem.status"
            ]
          },
          {
            "id": "try",
            "title": "Try a real goal",
            "description": "Copy the runtime E2E prompt, paste it into Copilot, and confirm the goal loop inspects, fixes, updates, verifies, and closes with proof.",
            "media": {
              "image": "media/walkthrough-prompt.svg",
              "altText": "Runtime goal prompt"
            },
            "completionEvents": [
              "onCommand:copilotGoalSystem.copyPrompt"
            ]
          }
        ]
      }
    ]
  },
  "qna": "https://github.com/gabrimatic/copilot-goal-system/issues",
  "markdown": "github",
  "scripts": {
    "vscode:prepublish": "node scripts/prepare-bundle.mjs",
    "prepare:bundle": "node scripts/prepare-bundle.mjs",
    "check": "node --check extension.cjs && node --check lib/runtime-version.cjs && node --check lib/install-status.cjs && node --check lib/jsonc-file.cjs && node --check lib/copilot-paths.cjs && node --check lib/runtime-bundle.cjs && node --check scripts/prepare-bundle.mjs && node --check scripts/package.mjs",
    "package": "node scripts/package.mjs",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
