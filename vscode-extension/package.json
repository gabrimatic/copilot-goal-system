{
  "name": "copilot-goal-system",
  "displayName": "Copilot Goal System",
  "description": "One-command installer for persisted goal mode in GitHub Copilot CLI and VS Code Copilot Chat.",
  "version": "1.1.2",
  "publisher": "gabrimatic",
  "author": {
    "name": "Soroush Yousefpour",
    "url": "https://github.com/gabrimatic"
  },
  "license": "SEE LICENSE IN LICENSE",
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f2a2a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrimatic/copilot-goal-system.git"
  },
  "bugs": {
    "url": "https://github.com/gabrimatic/copilot-goal-system/issues"
  },
  "homepage": "https://github.com/gabrimatic/copilot-goal-system#readme",
  "files": [
    "extension.cjs",
    "lib/**",
    "README.md",
    "CHANGELOG.md",
    "SUPPORT.md",
    "LICENSE",
    "package.json",
    "media/**",
    "resources/**"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "copilot",
    "github-copilot",
    "goal",
    "workflow",
    "persistence",
    "hooks",
    "skills",
    "verification"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:copilotGoalSystem.install",
    "onCommand:copilotGoalSystem.installCli",
    "onCommand:copilotGoalSystem.installVscodeChat",
    "onCommand:copilotGoalSystem.status",
    "onCommand:copilotGoalSystem.openWalkthrough",
    "onCommand:copilotGoalSystem.copyPrompt",
    "onCommand:copilotGoalSystem.openDocs",
    "onCommand:copilotGoalSystem.openInstalledFiles",
    "onCommand:copilotGoalSystem.openStateFolder"
  ],
  "main": "./extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "copilotGoalSystem.install",
        "title": "Install Recommended Setup",
        "category": "Copilot Goal System",
        "icon": "$(cloud-download)"
      },
      {
        "command": "copilotGoalSystem.installCli",
        "title": "Install into Copilot CLI",
        "category": "Copilot Goal System",
        "icon": "$(terminal)"
      },
      {
        "command": "copilotGoalSystem.installVscodeChat",
        "title": "Install into VS Code Copilot Chat",
        "category": "Copilot Goal System",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "copilotGoalSystem.status",
        "title": "Show Status",
        "category": "Copilot Goal System",
        "icon": "$(pulse)"
      },
      {
        "command": "copilotGoalSystem.openWalkthrough",
        "title": "Open Setup Walkthrough",
        "category": "Copilot Goal System",
        "icon": "$(checklist)"
      },
      {
        "command": "copilotGoalSystem.copyPrompt",
        "title": "Copy Test Prompt",
        "category": "Copilot Goal System",
        "icon": "$(copy)"
      },
      {
        "command": "copilotGoalSystem.openDocs",
        "title": "Open Documentation",
        "category": "Copilot Goal System",
        "icon": "$(book)"
      },
      {
        "command": "copilotGoalSystem.openInstalledFiles",
        "title": "Open Installed Files",
        "category": "Copilot Goal System",
        "icon": "$(folder-opened)"
      },
      {
        "command": "copilotGoalSystem.openStateFolder",
        "title": "Open Goal State Folder",
        "category": "Copilot Goal System",
        "icon": "$(database)"
      }
    ],
    "configuration": {
      "title": "Copilot Goal System",
      "properties": {
        "copilotGoalSystem.homeOverride": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional home directory override for install and status commands. Leave empty to use the current OS user home."
        },
        "copilotGoalSystem.showStatusAfterInstall": {
          "type": "boolean",
          "default": true,
          "description": "Show an install status report after installing or updating the goal system."
        },
        "copilotGoalSystem.promptOnFirstRun": {
          "type": "boolean",
          "default": true,
          "description": "Show one first-run setup prompt when the goal system is not installed into the local Copilot CLI profile."
        },
        "copilotGoalSystem.promptOnUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Prompt after extension updates when the installed local Copilot runtime files are older than the bundled files."
        },
        "copilotGoalSystem.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a compact Copilot Goal System status item in the VS Code status bar."
        },
        "copilotGoalSystem.vscodeMcpConfigPathOverride": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional VS Code MCP user configuration path override. Leave empty to use the current VS Code profile path."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "copilotGoalSystem.setup",
        "title": "Set Up Copilot Goal System",
        "description": "Install persisted goal mode for GitHub Copilot CLI and VS Code Copilot Chat.",
        "steps": [
          {
            "id": "install",
            "title": "Install or update the local goal system",
            "description": "Run the install command to copy the bundled goal system, install production dependencies, merge CLI hooks, add the VS Code Chat custom agent, and configure the local MCP server.",
            "media": {
              "image": "media/walkthrough-install.svg",
              "altText": "Goal system install flow"
            },
            "completionEvents": [
              "onCommand:copilotGoalSystem.install"
            ]
          },
          {
            "id": "status",
            "title": "Check installation status",
            "description": "Run the status command to confirm the extension files, dependencies, CLI hooks, VS Code Chat hooks, custom agent, and MCP configuration are present.",
            "media": {
              "image": "media/walkthrough-status.svg",
              "altText": "Goal system status checks"
            },
            "completionEvents": [
              "onCommand:copilotGoalSystem.status"
            ]
          },
          {
            "id": "try",
            "title": "Try a real goal",
            "description": "Copy the runtime E2E prompt, paste it into Copilot CLI or VS Code Copilot Chat, and confirm the goal system forces inspect, fix, update, verify, and close behavior.",
            "media": {
              "image": "media/walkthrough-prompt.svg",
              "altText": "Runtime goal prompt"
            },
            "completionEvents": [
              "onCommand:copilotGoalSystem.copyPrompt"
            ]
          }
        ]
      }
    ]
  },
  "qna": "https://github.com/gabrimatic/copilot-goal-system/issues",
  "markdown": "github",
  "scripts": {
    "vscode:prepublish": "node scripts/prepare-bundle.mjs",
    "prepare:bundle": "node scripts/prepare-bundle.mjs",
    "check": "node --check extension.cjs && node --check lib/runtime-version.cjs && node --check scripts/prepare-bundle.mjs && node --check scripts/package.mjs",
    "package": "node scripts/package.mjs",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  }
}
